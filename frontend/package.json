{
  "name": "frontend-diario-gamer",
  "version": "1.0.0",
  "description": "Frontend React y TypeScript del Diario de Progreso Gamer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --require ../scripts/test-file-guard.cjs node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:coverage": "node --require ../scripts/test-file-guard.cjs node_modules/vitest/vitest.mjs run --config vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.19.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "3.2.6",
    "autoprefixer": "^10.6.1",
    "jsdom": "26.1.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.4.0",
    "vite": "^5.1.0",
    "vitest": "3.2.6"
  }
}
